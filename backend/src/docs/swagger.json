{
  "openapi": "3.0.3",
  "info": {
    "title": "Notates API",
    "description": "projekt projekt",
    "version": "1.0.0"
  },
  "paths": {
    "/posts": {
      "summary": "Get a list of all posts",
      "description": "Returns a list of all games in api",
      "get": {
        "summary": "Get list of all games",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PostListItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Create method",
        "description": "Post Create method for creating posts",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get post by specific ID",
        "description": "Get a detailed post with a specific ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Modify post with specified ID",
        "description": "Modify a post with specified ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Required information to make a post",
          "content": {
            "application/json": {}
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "summary": "Delete post with specified ID",
        "description": "Destroy a post with specified id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostListItem": {
        "title": "Post List Item",
        "description": "{\n\"PostTitle\": \"Universes\",\n\"ContentLink\": \"Ababa\",\n\"PostDescription\": \"Ababa\",\n\"ReleaseDate\": \"01/01/2001\"\n}",
        "type": "object",
        "properties": {
          "PostTitle": {
            "type": "string",
            "example": "Universes"
          },
          "ContentLink": {
            "type": "string",
            "example": "Ababa"
          },
          "PostDescription": {
            "type": "string",
            "example": "Ababa"
          },
          "ReleaseDate": {
            "type": "string",
            "example": "01/01/2001"
          }
        }
      }
    }
  }
}