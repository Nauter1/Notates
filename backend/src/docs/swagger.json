{
  "openapi": "3.0.3",
  "info": {
    "title": "Notates API",
    "description": "projekt projekt",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://petstore3.swagger.io/api/v3"
    }
  ],
  "paths": {
    "/posts": {
      "summary": "Get a list of all posts",
      "description": "Returns a list of all games in api",
      "get": {
        "summary": "Get list of all games",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Create method",
        "description": "Post Create method for creating posts",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get post by specific ID",
        "description": "Get a detailed post with a specific ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Modify post with specified ID",
        "description": "Modify a post with specified ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "summary": "Delete post with specified ID",
        "description": "Destroy a post with specified id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/reactions": {
      "summary": "Get a reaction",
      "description": "Get a reaction",
      "get": {
        "summary": "Get a Game from the list",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionsListItem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a specific reaction",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/reactions/reaction": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {}
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/reactions/comment": {
      "post": {
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/reactions/{id}": {
      "summary": "Get a reaction",
      "description": "Get a reaction",
      "get": {
        "summary": "Get a Game from the list",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionsListItem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a specific reaction",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostListItem": {
        "title": "Post List Item",
        "description": "{\n\"PostTitle\": \"Universes\",\n\"ContentLink\": \"Ababa\",\n\"PostDescription\": \"Ababa\",\n\"ReleaseDate\": \"01/01/2001\"\n}",
        "type": "object"
      },
      "Pet": {
        "required": [
          "name",
          "photoUrls"
        ],
        "type": "object",
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer",
            "example": 10
          },
          "name": {
            "type": "string",
            "example": "doggie"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "photoUrls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "status": {
            "description": "pet status in the store",
            "enum": [
              "available",
              "pending",
              "sold"
            ],
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Dogs"
          }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ReactionsListItem": {
        "title": "Reactions List Item",
        "description": "{\n\"id\":\"jabadabaduu\",\n\"Content\":\"message\"\n\n}",
        "type": "object"
      }
    }
  }
}