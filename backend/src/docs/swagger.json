{
  "openapi": "3.0.3",
  "info": {
    "title": "Notates API",
    "description": "projekt projekt",
    "version": "1.0.0"
  },
  "paths": {
    "/posts": {
      "summary": "Get a list of all posts",
      "description": "Returns a list of all games in api",
      "get": {
        "summary": "Get list of all games",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PostListItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Create method",
        "description": "Post Create method for creating posts",
        "requestBody": {
          "description": "Request Body for creating a post",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostListItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get post by specific ID",
        "description": "Get a detailed post with a specific ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Modify post with specified ID",
        "description": "Modify a post with specified ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Required information to make a post",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostListItem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "summary": "Delete post with specified ID",
        "description": "Destroy a post with specified id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected post",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/badges": {
      "get": {
        "summary": "Get list of all badges",
        "description": "Returns the id and Title of every badge",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BadgeListItem"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to retrieve badges"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a badge",
        "description": "Creates a new badge. Title and Description are required. isAdmin, isPlusMember and isVerifiedArtist are always set to false on creation, postCount and reactionCount default to 0.",
        "requestBody": {
          "description": "Badge to create",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BadgeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Badge"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - request body missing, or Title / Description missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Missing parameters, please review data"
                }
              }
            }
          }
        }
      }
    },
    "/badges/{id}": {
      "get": {
        "summary": "Get badge by specific ID",
        "description": "Get a detailed badge with a specific ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected badge",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Badge"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Badge not found with id: 01a18710-a6c5-73c8-b9bc-f07aeb27dcc4"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to retrieve badge"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Modify badge with specified ID",
        "description": "Modify a badge with specified ID. Title and Description are required. isAdmin, isPlusMember and isVerifiedArtist cannot be changed through this endpoint.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected badge",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "New badge data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BadgeInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK - returns the updated badge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Badge"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - request body missing, or Title / Description missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Missing parameters, please review data"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Badge not found with id: 01a18710-a6c5-73c8-b9bc-f07aeb27dcc4"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to update badge"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete badge with specified ID",
        "description": "Destroy a badge with specified id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "id of selected badge",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Badge with this id does not exist: 01a18710-a6c5-73c8-b9bc-f07aeb27dcc4"
                }
              }
            }
          }
        }
      }
    },
    "/reactions": {
      "summary": "Get a reaction",
      "description": "Get a reaction",
      "get": {
        "summary": "Get a Game from the list",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionsListItem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a specific reaction",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/reactions/reaction": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {}
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/reactions/comment": {
      "post": {
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/reactions/{id}": {
      "summary": "Get a reaction",
      "description": "Get a reaction",
      "get": {
        "summary": "Get a Game from the list",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionsListItem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a specific reaction",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostListItem": {
        "title": "Post List Item",
        "description": "{\n\"PostTitle\": \"Universes\",\n\"ContentLink\": \"Ababa\",\n\"PostDescription\": \"Ababa\",\n\"ReleaseDate\": \"01/01/2001\"\n}",
        "type": "object",
        "properties": {
          "PostTitle": {
            "type": "string",
            "example": "Universes"
          },
          "ContentLink": {
            "type": "string",
            "example": "Ababa"
          },
          "PostDescription": {
            "type": "string",
            "example": "Ababa"
          },
          "ReleaseDate": {
            "type": "string",
            "example": "01/01/2001"
          }
        }
      },
      "BadgeListItem": {
        "title": "Badge List Item",
        "description": "Short badge info returned by GET /badges",
        "type": "object",
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string",
            "example": "01a18710-a6c5-73c8-b9bc-f07aeb27dcc4"
          },
          "Title": {
            "type": "string",
            "example": "Verified Artist"
          }
        }
      },
      "Badge": {
        "title": "Badge",
        "description": "Full badge as stored in the database",
        "type": "object",
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string",
            "example": "01a18710-a6c5-73c8-b9bc-f07aeb27dcc4"
          },
          "Title": {
            "type": "string",
            "example": "Verified Artist"
          },
          "Description": {
            "type": "string",
            "example": "Awarded to verified artists on Notates"
          },
          "DateObtained": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-29T10:00:00.000Z",
            "nullable": true
          },
          "JoinDate": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-15T00:00:00.000Z",
            "nullable": true
          },
          "isAdmin": {
            "type": "boolean",
            "example": false
          },
          "postCount": {
            "type": "integer",
            "example": 25
          },
          "isPlusMember": {
            "type": "boolean",
            "example": false
          },
          "reactionCount": {
            "type": "integer",
            "example": 150
          },
          "isVerifiedArtist": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-29T09:49:37.863Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-29T09:49:37.863Z"
          }
        }
      },
      "BadgeInput": {
        "title": "Badge Input",
        "description": "Request body for creating or modifying a badge. isAdmin, isPlusMember and isVerifiedArtist are not accepted.",
        "required": [
          "Title",
          "Description"
        ],
        "type": "object",
        "properties": {
          "Title": {
            "type": "string",
            "example": "Verified Artist"
          },
          "Description": {
            "type": "string",
            "example": "Awarded to verified artists on Notates"
          },
          "DateObtained": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-29T10:00:00.000Z"
          },
          "JoinDate": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-15T00:00:00.000Z"
          },
          "postCount": {
            "type": "integer",
            "example": 25
          },
          "reactionCount": {
            "type": "integer",
            "example": 150
          }
        }
      },
      "ReactionsListItem": {
        "title": "Reactions List Item",
        "description": "{\n\"id\":\"jabadabaduu\",\n\"Content\":\"message\"\n\n}",
        "type": "object"
      },
      "Error": {
        "title": "Error",
        "description": "Error message returned by the API",
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Missing parameters, please review data"
          }
        }
      }
    }
  }
}